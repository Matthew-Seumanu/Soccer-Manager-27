name: Build APK

on:
  push:
    branches: [main, master]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unzip the game project
        run: |
          Z="$(ls *.zip | head -n1)"
          echo "Using $Z"
          unzip -q -o "$Z" -d build

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Install Capacitor
        working-directory: build/pitchside-app
        run: npm install --no-audit --no-fund

      - name: Copy the game into the Android project
        working-directory: build/pitchside-app
        run: npx cap sync android

      - name: Build the APK
        working-directory: build/pitchside-app/android
        run: |
          chmod +x gradlew
          ./gradlew assembleRelease --no-daemon

      - name: Name the APK
        run: |
          mkdir -p out
          cp build/pitchside-app/android/app/build/outputs/apk/release/app-release.apk "out/PitchsideCareer-1.0.${{ github.run_number }}.apk"

      - name: Publish as a release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: Pitchside Career 1.0.${{ github.run_number }}
          files: out/*.apk
